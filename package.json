{
  "name": "primatif-comics",
  "version": "0.1.0",
  "description": "Comic Panel Creator",
  "type": "module",
  "scripts": {
    "start": "vite",
    "frontend:dev": "vite",
    "dev": "tauri dev",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "format": "prettier --write .",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "frontend:lint": "eslint src/**/*.{ts,tsx}",
    "test": "bun test",
    "task:add": "node scripts/add-task/index.js",
    "task:add:current": "node scripts/add-task/index.js --target current",
    "task:add:backlog": "node scripts/add-task/index.js --target backlog",
    "task:add:dry": "node scripts/add-task/index.js --dry",
    "release": "semantic-release",
    "qa:all": "bun test && cd src-tauri && cargo test && cargo clippy -- -D warnings && cargo fmt -- --check && bun run frontend:lint"
  },
  "license": "PolyForm Strict License 1.0.0",
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@tailwindcss/postcss": "^4.1.11",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "install": "^0.13.0",
    "pixi.js": "8",
    "solid-js": "^1.9.9",
    "solid-pixi": "^1.0.0"
  },
  "devDependencies": {
    "@kobalte/tailwindcss": "^0.9.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.4",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-solid": "^0.14.5",
    "markdownlint-cli2": "^0.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.6.2",
    "vite": "^7.0.6",
    "vite-plugin-solid": "^2.11.7"
  },
  "module": "src/index.tsx",
  "private": true
}
